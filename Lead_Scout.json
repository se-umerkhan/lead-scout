    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Exponential backoff for the Briefing sheet status update.\n// The retry count travels with the item coming back from 'Check Max Retries'.\nconst maxRetries = 5;\nconst initialDelay = 1; // seconds\nlet retryCount = 0;\ntry {\n  retryCount = Number($('Check Max Retries').item.json.retryCount) || 0;\n} catch (e) {\n  retryCount = 0; // first failure for this item\n}\n\nif (retryCount < maxRetries) {\n  const delay = initialDelay * Math.pow(2, retryCount);\n  console.log(`Waiting for ${delay} seconds before retry...`);\n  return { json: { retryCount: retryCount + 1, waitTimeInSeconds: delay, status: 'retrying' } };\n}\nreturn { json: { error: 'Max retries exceeded', retryCount: retryCount, waitTimeInSeconds: 0, status: 'failed' } };\n"
      },
      "id": "a8d95d0b-195e-451e-a577-fe3cbfa3a8a9",
      "name": "Exponential Backoff1",
      "type": "n8n-nodes-base.code",
      "position": [
        624,
        1040
      ],
      "typeVersion": 2
    },
