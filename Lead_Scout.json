    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Merge the scraped website HTML with the original place item and pull out a contact email.\nconst base = $json.place ? $json : $('Remove Duplicates').item.json;\nconst raw = $json.place ? '' : (typeof $json.data === 'string' ? $json.data : '');\nlet text = raw.slice(0, 600000);\ntry { text = decodeURIComponent(text.replace(/%(?![0-9A-Fa-f]{2})/g, '%25')); } catch (e) {}\ntext = text.replace(/\\s?[\\[\\(]at[\\]\\)]\\s?/gi, '@').replace(/&#0*64;|&commat;/gi, '@');\nconst found = text.match(/[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)*\\.[A-Za-z]{2,}/g) || [];\nconst junk = /\\.(png|jpe?g|gif|svg|webp|css|js|woff2?|ico)$|sentry|wixpress|example\\.|yourdomain|domain\\.com|schema\\.org|u003e|noreply|no-reply/i;\nconst emails = [...new Set(found.map(e => e.toLowerCase().replace(/^[^a-z0-9]+/, '')).filter(e => !junk.test(e)))];\nlet host = '';\ntry { host = new URL(base.place.websiteUri).hostname.replace(/^www\\./, ''); } catch (e) {}\nconst preferred = emails.find(e => host && e.endsWith('@' + host)) || emails.find(e => /^(info|contact|hello|sales|office|support)@/.test(e)) || emails[0] || '';\nreturn { json: { ...base, Email: preferred, allEmails: emails.join(', ') } };\n"
      },
